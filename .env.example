# Copy to .env and fill in values. Never commit .env.
# The app reads .env in this folder first, then a .env one folder ABOVE this repo.
PORTKEY_API_KEY=
OPENAI_MODEL=gpt-6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
# true (default): skip Portkey's response replay so every run is a real model call with real token counts
PORTKEY_FORCE_REFRESH=true
# Overspending guard: the app refuses new searches once this many dollars have been spent today
DAILY_BUDGET_USD=2.00
